@startuml
skinparam handwritten false
skinparam monochrome false
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam rectangle {
    BackgroundColor White
    BorderColor Black
}

title Kiến trúc MVC - Hệ thống NP FutureGate

rectangle "View (Giao diện Flutter)" #White {
    rectangle "Ứng viên (Candidate)" #Lavender {
        [Trang chủ / Tin tuyển dụng]
        [Tìm kiếm / Lọc việc làm]
        [Việc làm đã ứng tuyển]
        [Lịch phỏng vấn / Test MI]
        [Quản lý CV / Hồ sơ cá nhân]
    }
    
    rectangle "Nhà tuyển dụng (Employer)" #Azure {
        [Dashboard quản lý]
        [Đăng tin & Quản lý việc làm]
        [Duyệt hồ sơ & Quản lý ứng viên]
        [Đặt lịch phỏng vấn]
    }
    
    rectangle "Quản trị viên (Admin)" #GhostWhite {
        [Quản lý người dùng]
        [Quản lý nội dung & Hệ thống]
    }
    
    rectangle "Chức năng chung" #Ivory {
        [Đăng nhập / Đăng ký / OTP]
        [Chat (Realtime) / Chatbot AI]
        [Thông báo (Push/In-app)]
    }
}

rectangle "Controller (Logic Repositories & Services)" #AliceBlue {
    rectangle "Repositories" {
        [AuthRepository]
        [JobRepository]
        [InterviewRepository]
        [CandidateRepository]
        [AdminUserRepository]
        [CareerNewsRepository]
    }
    
    rectangle "Services" {
        [SupabaseService]
        [FCMService]
        [AIService (Intent/Matching)]
        [OCRService]
        [ChatService]
        [PayOSService]
    }
}

rectangle "Model (Thực thể dữ liệu)" #White {
    rectangle "Entities" {
        [User / Profile]
        [Job / Category]
        [Application / Candidate]
        [Interview / Schedule]
        [CV / Document]
        [Course / CareerNews]
        [Message / Notification]
        [AI Intent / MI Result]
    }
}

database "Tầng dữ liệu (Data Store)" #Linen {
    [Supabase (PostgreSQL / Auth / Storage)]
    [Firebase Cloud Messaging (FCM)]
    [External Services (PayOS, AI Python Backend)]
}

"View (Giao diện Flutter)" <--> "Controller (Logic Repositories & Services)" : Tương tác / Cập nhật UI
"Controller (Logic Repositories & Services)" <--> "Model (Thực thể dữ liệu)" : Logic nghiệp vụ
"Model (Thực thể dữ liệu)" <--> "Tầng dữ liệu (Data Store)" : Truy vấn / Lưu trữ

@enduml
