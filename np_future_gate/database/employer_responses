-- Bảng phản hồi từ nhà tuyển dụng đến ứng viên
create table public.employer_responses (
  id uuid not null default gen_random_uuid(),
  employer_id uuid not null references public.profiles(id) on delete cascade,
  candidate_id uuid not null references public.profiles(id) on delete cascade,
  job_id uuid references public.jobs(id) on delete set null,
  response_type text not null default 'other' check (response_type in ('accepted', 'rejected', 'interview_invitation', 'other')),
  message text not null,
  attachments jsonb default '[]'::jsonb,
  metadata jsonb default '{}'::jsonb,
  created_at timestamp with time zone not null default now(),
  updated_at timestamp with time zone not null default now(),
  constraint employer_responses_pkey primary key (id),
  -- Constraint: Attachments phải là array và mỗi file không quá 1MB (1048576 bytes)
  constraint check_attachments_size check (
    jsonb_typeof(attachments) = 'array'
  )
);

-- Tạo index để tối ưu query
create index employer_responses_employer_id_idx on public.employer_responses(employer_id);
create index employer_responses_candidate_id_idx on public.employer_responses(candidate_id);
create index employer_responses_job_id_idx on public.employer_responses(job_id);
create index employer_responses_response_type_idx on public.employer_responses(response_type);
create index employer_responses_created_at_idx on public.employer_responses(created_at desc);

-- Function tự động update updated_at
create or replace function public.handle_updated_at()
returns trigger as $$
begin
  new.updated_at = now();
  return new;
end;
$$ language plpgsql;

-- Trigger tự động update updated_at
create trigger set_updated_at
  before update on public.employer_responses
  for each row
  execute function public.handle_updated_at();

-- Bật RLS (Row Level Security)
alter table public.employer_responses enable row level security;

-- Policy 1: Ai cũng có thể xem responses (cho admin nếu cần)
create policy "Public responses are viewable by everyone." 
  on public.employer_responses
  for select 
  using (true);

-- Policy 2: Employer có thể tạo response cho candidates
create policy "Employers can create responses for candidates." 
  on public.employer_responses
  for insert 
  with check (
    auth.uid() = employer_id
  );

-- Policy 3: Employer có thể update responses của mình
create policy "Employers can update their own responses." 
  on public.employer_responses
  for update 
  using (
    auth.uid() = employer_id
  );

-- Policy 4: Employer có thể xóa responses của mình
create policy "Employers can delete their own responses." 
  on public.employer_responses
  for delete 
  using (
    auth.uid() = employer_id
  );

-- Policy 5: Candidate có thể xem responses gửi cho mình
create policy "Candidates can view responses sent to them." 
  on public.employer_responses
  for select 
  using (
    auth.uid() = candidate_id
  );

-- Comment giải thích cấu trúc attachments
comment on column public.employer_responses.attachments is 
'JSONB array chứa thông tin file đính kèm. 
Mỗi file không quá 1MB (1048576 bytes).
Cấu trúc: [
  {
    "url": "https://storage.url/file.pdf",
    "type": "application/pdf",
    "name": "file_name.pdf",
    "size": 512000
  }
]';

-- Comment giải thích cấu trúc metadata
comment on column public.employer_responses.metadata is 
'JSONB object chứa thông tin tùy chỉnh.
Ví dụ: {
  "response_type": "interview_invitation",
  "interview_date": "2024-01-15",
  "location": "Hà Nội",
  "salary_offer": 20000000
}';
