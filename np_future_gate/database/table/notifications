-- 7. Trigger để tự động cập nhật updated_at
create trigger on_notifications_updated
  before update on public.notifications
  for each row execute procedure public.handle_updated_at();

-- 8. Function để tự động xóa thông báo hết hạn
create or replace function public.delete_expired_notifications()
returns void
language plpgsql
security definer
as $$
begin
  delete from public.notifications
  where expires_at is not null 
    and expires_at < now();
  
  raise notice 'Deleted expired notifications';
end;
$$;

