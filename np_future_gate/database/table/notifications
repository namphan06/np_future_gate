-- 1. Tạo bảng notifications
-- Bảng quản lý thông báo hệ thống
-- Hỗ trợ gửi đến: tất cả, nhiều người, hoặc một người cụ thể
create table public.notifications (
  id uuid not null default gen_random_uuid() primary key,
  created_at timestamp with time zone not null default now(),
  updated_at timestamp with time zone not null default now(),

  -- Người nhận (không dùng foreign key để linh hoạt)
  -- Có thể là:
  -- - 'all': gửi đến tất cả user
  -- - uuid đơn: '123e4567-e89b-12d3-a456-426614174000' (gửi đến 1 người)
  -- - mảng uuid: '["uuid1", "uuid2", "uuid3"]' (gửi đến nhiều người)
  recipient_ids text not null,

  -- Tiêu đề thông báo
  title text not null,

  -- Nội dung thông báo
  content text not null,

  -- Mã điều hướng
  -- VD: 'job_detail', 'interview_schedule', 'partnership_request', 'system_update', etc.
  action_code text,

  -- Dữ liệu bổ sung cho action (JSON)
  -- VD: {"job_id": "uuid", "interview_id": "uuid", etc.}
  action_data jsonb,

  -- Trạng thái thông báo
  is_active boolean default true,

  -- Loại thông báo (để filter hoặc styling)
  type text check (type in ('info', 'success', 'warning', 'error', 'announcement', "requirement", "reminder")) default 'info',

  -- Người gửi (optional, có thể là system)
  sender_id uuid references auth.users(id) on delete set null,

  -- Thời gian hết hạn (mặc định 30 ngày từ khi tạo)
  expires_at timestamp with time zone default (now() + interval '30 days')
);

-- 2. Tạo bảng notification_reads để track đã đọc
-- Bảng này ghi nhận user nào đã đọc notification nào
create table public.notification_reads (
  id uuid not null default gen_random_uuid() primary key,
  notification_id uuid not null references public.notifications(id) on delete cascade,
  user_id uuid not null references auth.users(id) on delete cascade,
  read_at timestamp with time zone not null default now(),
  
  -- Đảm bảo mỗi user chỉ đọc 1 notification 1 lần
  unique(notification_id, user_id)
);

-- 3. Tạo Index
create index notifications_recipient_ids_idx on public.notifications (recipient_ids);
create index notifications_action_code_idx on public.notifications (action_code);
create index notifications_created_at_idx on public.notifications (created_at desc);
create index notifications_is_active_idx on public.notifications (is_active);
create index notifications_type_idx on public.notifications (type);
create index notification_reads_user_id_idx on public.notification_reads (user_id);
create index notification_reads_notification_id_idx on public.notification_reads (notification_id);

-- 4. Bật Row Level Security (RLS)
alter table public.notifications enable row level security;
alter table public.notification_reads enable row level security;

-- 5. Tạo Policies cho notifications

-- Policy 1: Ai cũng có thể xem thông báo dành cho 'all'
create policy "Everyone can view notifications for all"
on public.notifications for select
using (
  is_active = true 
  and recipient_ids = 'all'
  and (expires_at is null or expires_at > now())
);

-- Policy 2: User có thể xem thông báo gửi riêng cho mình (single UUID)
create policy "Users can view their own notifications"
on public.notifications for select
using (
  is_active = true 
  and recipient_ids = auth.uid()::text
  and (expires_at is null or expires_at > now())
);

-- Policy 3: User có thể xem thông báo nếu ID của họ nằm trong mảng
create policy "Users can view notifications in recipient array"
on public.notifications for select
using (
  is_active = true 
  and recipient_ids like '%' || auth.uid()::text || '%'
  and (expires_at is null or expires_at > now())
);

