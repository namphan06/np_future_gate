-- 9b. Alternative: Tự động xóa khi insert notification mới (không cần cron)
create or replace function public.auto_delete_expired_on_insert()
returns trigger
language plpgsql
as $$
begin
  -- Xóa thông báo hết hạn mỗi khi có notification mới được tạo
  delete from public.notifications
  where expires_at is not null 
    and expires_at < now();
  
  return new;
end;
$$;

create trigger auto_cleanup_expired_notifications
  after insert on public.notifications
  for each statement
  execute function public.auto_delete_expired_on_insert();

-- 10. Function để lấy thông báo chưa đọc của user
create or replace function public.get_unread_notifications(user_uuid uuid)
returns table (
  id uuid,
  created_at timestamptz,
  title text,
  content text,
  action_code text,
  action_data jsonb,
  type text
)
language plpgsql
security definer
as $$
begin
  return query
  select 
    n.id,
    n.created_at,
    n.title,
    n.content,
    n.action_code,
    n.action_data,
    n.type
  from public.notifications n
  where n.is_active = true
    and (n.expires_at is null or n.expires_at > now())
    and (
      n.recipient_ids = 'all' 
      or n.recipient_ids = user_uuid::text
      or n.recipient_ids like '%' || user_uuid::text || '%'
    )
    and not exists (
      select 1 
      from public.notification_reads nr 
      where nr.notification_id = n.id 
        and nr.user_id = user_uuid
    )
  order by n.created_at desc;
end;
$$;



-- 11. Function để đếm số thông báo chưa đọc
create or replace function public.count_unread_notifications(user_uuid uuid)
returns integer
language plpgsql
security definer
as $$
declare
  unread_count integer;
begin
  select count(*)::integer into unread_count
  from public.notifications n
  where n.is_active = true
    and (n.expires_at is null or n.expires_at > now())
    and (
      n.recipient_ids = 'all' 
      or n.recipient_ids = user_uuid::text
      or n.recipient_ids like '%' || user_uuid::text || '%'
    )
    and not exists (
      select 1 
      from public.notification_reads nr 
      where nr.notification_id = n.id 
        and nr.user_id = user_uuid
    );
  
  return unread_count;
end;
$$;

