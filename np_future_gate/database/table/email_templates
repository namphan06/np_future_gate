-- Email Templates Table (Simplified)
-- Lưu email templates cho employers

create table public.email_templates (
  employer_id uuid not null references public.profiles(id) on delete cascade,
  response_type text not null check (response_type in ('accepted', 'rejected', 'interview')),
  subject text not null,
  body text not null,
  attachments jsonb default '[]'::jsonb,
  created_at timestamp with time zone not null default now(),
  updated_at timestamp with time zone not null default now(),
  
  constraint email_templates_pkey primary key (employer_id, response_type)
);

-- Indexes
create index email_templates_employer_id_idx on public.email_templates (employer_id);

-- Enable RLS
alter table public.email_templates enable row level security;

-- RLS Policies
create policy "Employers can view own templates"
  on public.email_templates for select
  using (auth.uid() = employer_id);

create policy "Employers can insert own templates"
  on public.email_templates for insert
  with check (auth.uid() = employer_id);

create policy "Employers can update own templates"
  on public.email_templates for update
  using (auth.uid() = employer_id);

create policy "Employers can delete own templates"
  on public.email_templates for delete
  using (auth.uid() = employer_id);

-- Auto-update updated_at trigger
create trigger on_email_templates_updated
  before update on public.email_templates
  for each row execute procedure public.handle_updated_at();

-- Comments
comment on table public.email_templates is 'Email templates cho employers để gửi phản hồi ứng viên';
comment on column public.email_templates.subject is 'Tiêu đề email với biến {{variable}}';
comment on column public.email_templates.body is 'Nội dung email với biến {{variable}}';
comment on column public.email_templates.attachments is 'Danh sách file đính kèm: [{url, name, size, type}]';

