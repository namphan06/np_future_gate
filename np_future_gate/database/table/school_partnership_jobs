-- Nhà trường có thể xóa tin của mình (chỉ khi chưa được công ty chấp nhận)
create policy "Schools can delete own partnership jobs before company acceptance"
on public.school_partnership_jobs for delete
using ( 
  auth.uid() = school_id 
  and company_status = 'pending' 
);

-- 5. Trigger để tự động cập nhật updated_at
create trigger on_school_partnership_jobs_updated
  before update on public.school_partnership_jobs
  for each row execute procedure public.handle_updated_at();

-- 6. Trigger để tự động cập nhật thời gian duyệt
create or replace function public.handle_partnership_job_review()
returns trigger as $$
begin
  -- Cập nhật thời gian duyệt của công ty
  if old.company_status <> new.company_status and new.company_status <> 'pending' then
    new.company_reviewed_at = now();
  end if;

  -- Cập nhật thời gian duyệt của admin
  if old.admin_status <> new.admin_status and new.admin_status <> 'pending' then
    new.admin_reviewed_at = now();
  end if;

  return new;
end;
$$ language plpgsql;

create trigger on_partnership_job_review_status_changed
  before update on public.school_partnership_jobs
  for each row execute procedure public.handle_partnership_job_review();
